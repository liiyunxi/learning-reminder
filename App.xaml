<Application x:Class="LearningReminder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <!-- 布尔到可见性的转换 -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- 像素字体（SIL OFL 许可，随应用分发）：字号取 12 的整数倍，保证像素锐利 -->
            <FontFamily x:Key="Font.App">pack://application:,,,/Fonts/#Fusion Pixel 12px Prop zh_hans</FontFamily>

            <!-- 应用标识（像素书 + 绿色底座，与托盘图标同一口径） -->
            <BitmapImage x:Key="AppLogo" UriSource="pack://application:,,,/Assets/logo-64.png" />

            <!-- ============ 配色（像素风：硬描边 + 高对比扁平色） ============ -->
            <SolidColorBrush x:Key="Brush.Ink" Color="#1F2033" />
            <SolidColorBrush x:Key="Brush.Primary" Color="#4F46E5" />
            <SolidColorBrush x:Key="Brush.PrimaryDark" Color="#3730A3" />
            <SolidColorBrush x:Key="Brush.PrimarySoft" Color="#E4E4FF" />
            <SolidColorBrush x:Key="Brush.Success" Color="#10B981" />
            <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#D9F7EC" />
            <SolidColorBrush x:Key="Brush.Warn" Color="#F59E0B" />
            <SolidColorBrush x:Key="Brush.WarnSoft" Color="#FDEBC8" />
            <SolidColorBrush x:Key="Brush.Danger" Color="#EF4444" />
            <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Brush.Page" Color="#F1EFE6" />
            <SolidColorBrush x:Key="Brush.Border" Color="#1F2033" />
            <SolidColorBrush x:Key="Brush.Text" Color="#1F2033" />
            <SolidColorBrush x:Key="Brush.Muted" Color="#5B5B73" />
            <SolidColorBrush x:Key="Brush.Disabled" Color="#B9B7AC" />

            <!-- ============ 标题栏按钮（自绘标题栏用） ============ -->
            <Style x:Key="TitleBarButton" TargetType="Button">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Ink}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Danger}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Ink}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#C81E1E" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 文本 ============ -->
            <Style x:Key="Text.Title" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Style>

            <Style x:Key="Text.CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="Text.Muted" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
            </Style>

            <Style x:Key="Text.Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="Text.FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <!-- 小标签（模式 / 状态 / 分组） -->
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ink}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>

            <Style x:Key="Chip.Text" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
            </Style>

            <!-- ============ 按钮（像素块：按下时整体位移、阴影收拢） ============ -->
            <Style x:Key="Button.Base" TargetType="Button">
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ink}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Shadow" Background="{StaticResource Brush.Ink}" Margin="3,3,0,0" />
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Margin="0,0,3,3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Margin" Value="1,1,2,2" />
                                    <Setter TargetName="Shadow" Property="Margin" Value="2,2,1,1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Margin" Value="3,3,0,0" />
                                    <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="Shadow" Property="Opacity" Value="0.2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="Button.Success" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="{StaticResource Brush.Success}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            </Style>

            <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
            </Style>

            <Style x:Key="Button.Link" TargetType="Button">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryDark}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Disabled}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 输入控件 ============ -->
            <Style x:Key="TextBox.Base" TargetType="TextBox">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ink}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                <Setter Property="CaretBrush" Value="{StaticResource Brush.Primary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CheckBox.Base" TargetType="CheckBox">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box"
                                        Width="16" Height="16"
                                        Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.Ink}"
                                        BorderThickness="2"
                                        VerticalAlignment="Center">
                                    <Path x:Name="Mark"
                                          Data="M 2,6 L 5,9 L 10,2"
                                          Stroke="White"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Square"
                                          StrokeEndLineCap="Square"
                                          StrokeLineJoin="Miter"
                                          Width="12" Height="12" Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Success}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Mark" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 单选按钮（方形，选中为实心方块） -->
            <Style x:Key="Radio.Base" TargetType="RadioButton">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,20,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Ring"
                                        Width="16" Height="16"
                                        Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.Ink}"
                                        BorderThickness="2"
                                        VerticalAlignment="Center">
                                    <Rectangle x:Name="Dot"
                                               Width="8" Height="8"
                                               Fill="{StaticResource Brush.Primary}"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 方块型单选/多选（重复规则、筛选、模板选择用） -->
            <Style x:Key="Pill.Radio" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Padding="12,6"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Ink}"
                                    BorderThickness="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Primary}" />
                                    <Setter Property="TextElement.Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PrimaryDark}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Pill.Check" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Bd" Padding="12,6"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Ink}"
                                    BorderThickness="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.PrimaryDark}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.WarnSoft}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 进度条（方块刻度） -->
            <Style x:Key="Progress.Pixel" TargetType="ProgressBar">
                <Setter Property="Height" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ink}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 选项卡（像素标签页） ============ -->
            <Style x:Key="Tab.Pixel" TargetType="TabItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd"
                                    Padding="14,7"
                                    Margin="0,0,8,0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="2">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Ink}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Text}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Muted}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 卡片（硬描边 + 像素硬阴影） ============ -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ink}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Margin" Value="0,0,4,10" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="0" ShadowDepth="4" Direction="315"
                                          Opacity="1" Color="#1F2033" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 日历格子（方块） ============ -->
            <Style x:Key="CalendarDay" TargetType="Button">
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Ink}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>