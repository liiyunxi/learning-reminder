<Application x:Class="LearningReminder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <!-- 布尔到可见性的转换 -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- ============ 应用标识（书本 + 对勾：学习为宗旨，自律为目标） ============ -->
            <DrawingImage x:Key="AppLogo">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <!-- 圆角底：靛蓝到紫罗兰 -->
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F46E5" Offset="0" />
                                    <GradientStop Color="#7C3AED" Offset="1" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M 0,7 A 7,7 0 0 1 7,0 H 17 A 7,7 0 0 1 24,7 V 17 A 7,7 0 0 1 17,24 H 7 A 7,7 0 0 1 0,17 Z" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- 摊开的书 -->
                        <GeometryDrawing Brush="#FFFFFF"
                                         Geometry="M 4,8.2 L 11,10.6 L 11,19.6 L 4,17.2 Z" />
                        <GeometryDrawing Brush="#D9DEF0"
                                         Geometry="M 13,10.6 L 20,8.2 L 20,17.2 L 13,19.6 Z" />
                        <!-- 完成徽章 + 对勾 -->
                        <GeometryDrawing Brush="#10B981">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="18.6,18.6" RadiusX="4.6" RadiusY="4.6" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FFFFFF">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="18.6,18.6" RadiusX="3.4" RadiusY="3.4" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#10B981" Thickness="1.7"
                                     StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M 16.6,18.5 L 18,19.9 L 20.7,16.9" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- ============ 配色 ============ -->
            <SolidColorBrush x:Key="Brush.Primary" Color="#4F46E5" />
            <SolidColorBrush x:Key="Brush.PrimarySoft" Color="#EEF2FF" />
            <SolidColorBrush x:Key="Brush.Success" Color="#10B981" />
            <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#ECFDF5" />
            <SolidColorBrush x:Key="Brush.Warn" Color="#F59E0B" />
            <SolidColorBrush x:Key="Brush.WarnSoft" Color="#FFF7ED" />
            <SolidColorBrush x:Key="Brush.Danger" Color="#EF4444" />
            <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Brush.Page" Color="#F5F6FA" />
            <SolidColorBrush x:Key="Brush.Border" Color="#E5E7EB" />
            <SolidColorBrush x:Key="Brush.Text" Color="#111827" />
            <SolidColorBrush x:Key="Brush.Muted" Color="#6B7280" />
            <SolidColorBrush x:Key="Brush.Disabled" Color="#C7CBD1" />

            <!-- ============ 标题栏按钮（自绘标题栏用） ============ -->
            <Style x:Key="TitleBarButton" TargetType="Button">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Foreground" Value="#4B5563" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#D1D5DB" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Danger}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#DC2626" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 文本 ============ -->
            <Style x:Key="Text.Title" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Style>

            <Style x:Key="Text.CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="Text.Muted" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
            </Style>

            <Style x:Key="Text.Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="Text.FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <!-- 小标签（模式 / 状态） -->
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>

            <Style x:Key="Chip.Text" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
            </Style>

            <!-- ============ 按钮 ============ -->
            <Style x:Key="Button.Base" TargetType="Button">
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="Button.Success" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="{StaticResource Brush.Success}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                <Setter Property="BorderBrush" Value="#FECACA" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,7" />
            </Style>

            <!-- ============ 输入控件 ============ -->
            <Style x:Key="TextBox.Base" TargetType="TextBox">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CheckBox.Base" TargetType="CheckBox">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box"
                                        Width="18" Height="18"
                                        CornerRadius="5"
                                        Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1.2"
                                        VerticalAlignment="Center">
                                    <Path x:Name="Mark"
                                          Data="M 2.5,6 L 6,9.5 L 11.5,2.5"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Success}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 单选按钮 -->
            <Style x:Key="Radio.Base" TargetType="RadioButton">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,20,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Ring"
                                        Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1.2"
                                        VerticalAlignment="Center">
                                    <Ellipse x:Name="Dot"
                                             Width="8" Height="8"
                                             Fill="{StaticResource Brush.Primary}"
                                             Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 胶囊型单选/多选（重复规则选择用） -->
            <Style x:Key="Pill.Radio" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="8" Padding="13,6"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Primary}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                    <Setter Property="TextElement.Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Pill.Check" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Bd" CornerRadius="8" Padding="13,6"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Primary}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Progress.Rounded" TargetType="ProgressBar">
                <Setter Property="Height" Value="8" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                <Setter Property="Background" Value="#E5E7EB" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="4"
                                        Background="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 选项卡 ============ -->
            <Style x:Key="Tab.Pill" TargetType="TabItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd"
                                    CornerRadius="8"
                                    Padding="14,7"
                                    Margin="0,0,8,0"
                                    Background="Transparent">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Primary}" />
                                    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Muted}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 卡片 ============ -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- ============ 日历格子 ============ -->
            <Style x:Key="CalendarDay" TargetType="Button">
                <Setter Property="Height" Value="50" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>